  "cards": [
    {
      "dot": "cyan",
      "title": "The ephemeral situational rail",
      "items": [
        "Atoms (a-*, position beacons) get a short TTL derived from the CoT event's own stale time, supersede-only by entity uid, no acknowledgement, gated to CoT-capable peers only",
        "Bits (b-*, GeoChat/markers/files) ride the durable skcomms mail path: signed, retried, kept until read",
        "skcot consumes skcomms; skcomms never imports skcot, a one-way boundary"
      ]
    }
