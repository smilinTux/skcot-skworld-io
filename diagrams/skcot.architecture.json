    { "id": "tls-to-codec", "from": "tls", "to": "codec", "variant": "default" },
    { "id": "plain-to-codec", "from": "plain", "to": "codec", "variant": "default" },
    { "id": "udp-to-codec", "from": "udp", "to": "codec", "variant": "default" },
    { "id": "codec-to-geo", "from": "codec", "to": "geo", "label": "every event", "variant": "emphasis" },
    { "id": "codec-to-fed", "from": "codec", "to": "fed", "label": "a-* short TTL, no ack; b-* signed, retried", "variant": "default" },
    { "id": "fed-to-fabric", "from": "fed", "to": "fabric", "label": "federate to peers", "variant": "emphasis" },
    { "id": "fabric-to-fed", "from": "fabric", "to": "fed", "label": "inbox inject to local clients", "variant": "dashed", "fromSide": "bottom", "toSide": "bottom" },

    { "id": "geo-to-http", "from": "geo", "to": "geo_http", "variant": "default" },
    { "id": "http-to-skmap", "from": "geo_http", "to": "skmap", "label": "http GET", "variant": "default" },

    { "id": "agent-to-tls", "from": "agent", "to": "tls", "label": "connects as a unit", "variant": "default" },
    { "id": "agent-to-llm", "from": "agent", "to": "llm", "label": "GeoChat reply", "variant": "default" },
    { "id": "agent-to-skcapstone", "from": "agent", "to": "skcapstone", "label": "optional brain", "variant": "dashed" }
  ],
  "cards": [
    { "dot": "cyan", "title": "Two rails, one classifier", "items": [
      "is_ephemeral_beacon in skcot.codec decides every route: a-* position atoms vs b-* bits (GeoChat, markers, files)",
      "Ephemeral rail: TTL derived from the event's own stale time, supersede-only by uid, no acknowledgement, sent only to CoT-capable peers",
      "Durable rail: b-* events ride the fabric's mail path, signed, retried, kept until read"
    ] },
    { "dot": "emerald", "title": "A leaf on the fabric", "items": [
      "skcomms is the only hard dependency: envelopes, identity, discovery, trust-on-first-use",
      "skcomms never imports skcot; it reads live CoT at runtime over GET /geo/units instead",
      "skcapstone is optional; without it skcot is a plain CoT/TAK bridge plus situational store"
    ] },
    { "dot": "rose", "title": "Documented weak points", "items": [
      "The TLS listener runs ssl.CERT_OPTIONAL: a client cert attributes a device, it does not admit one; access control is the tailnet bind",
      "CA and server private keys sit on disk unencrypted; classical RSA-2048, maturity tier T0",
      "Self-built reference implementation, no independent audit; see SECURITY.md before relying on it"
    ] }
  ]
}
