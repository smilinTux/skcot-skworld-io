  "boundaries": [
    { "kind": "security-group", "label": "skcot.pki, sovereign CA on disk", "wraps": ["pkg", "ca"] },
    { "kind": "region", "label": "Tactical devices (tailnet or LAN)", "wraps": ["atak", "mesh"] },
    { "kind": "region", "label": "skcot.service, one process", "wraps": ["tls", "plain", "udp", "agent", "codec", "fed", "geo", "geo_http"] }
  ],
  "connections": [
    { "id": "ca-signs-pkg", "from": "ca", "to": "pkg", "label": "signs", "variant": "security" },
    { "id": "pkg-to-atak", "from": "pkg", "to": "atak", "label": "imported once on the device", "variant": "security" },
