    { "id": "atak", "type": "external", "label": "ATAK / iTAK / WinTAK", "sublabel": "enrolled TAK clients", "pos": [40, 210], "size": [170, 64] },
    { "id": "mesh", "type": "external", "label": "Mesh SA device", "sublabel": "UDP multicast, no server", "pos": [40, 490], "size": [170, 64] },

    { "id": "tls", "type": "backend", "label": "TlsCotStreamServer", "sublabel": ":8089 TLS, ssl.CERT_OPTIONAL", "pos": [300, 210], "size": [170, 64], "tag": "weak point" },
    { "id": "plain", "type": "backend", "label": "CotStreamServer", "sublabel": ":8087 plain TCP", "pos": [300, 350], "size": [170, 64] },
    { "id": "udp", "type": "backend", "label": "UdpMeshListener", "sublabel": "239.2.3.1:6969 + GeoChat group", "pos": [300, 490], "size": [170, 64] },
    { "id": "agent", "type": "backend", "label": "skcot.agent", "sublabel": "AI teammate: beacons position, reads GeoChat", "pos": [560, 210], "size": [170, 64] },
    { "id": "codec", "type": "backend", "label": "skcot.codec", "sublabel": "is_ephemeral_beacon: a-* vs b-*", "pos": [560, 350], "size": [170, 64] },
    { "id": "fed", "type": "backend", "label": "federation_ingest", "sublabel": "signed Envelope out, peer CoT injected in", "pos": [820, 210], "size": [170, 64] },
    { "id": "geo", "type": "database", "label": "GEO_STORE", "sublabel": "in-memory, supersede by uid", "pos": [820, 350], "size": [170, 64] },
    { "id": "geo_http", "type": "backend", "label": "skcot.geo_http", "sublabel": "127.0.0.1:8091, GET /geo/units", "pos": [820, 490], "size": [170, 64] },

    { "id": "fabric", "type": "external", "label": "skcomms fabric", "sublabel": "CoT-capable peer nodes", "pos": [1080, 210], "size": [170, 64] },
    { "id": "skmap", "type": "external", "label": "skcomms geo_store", "sublabel": "sources live CoT for SkMap", "pos": [1080, 490], "size": [170, 64] }
